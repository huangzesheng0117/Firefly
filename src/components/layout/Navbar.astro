---
import { Icon } from "astro-icon/components";
import { navBarConfig } from "@/config";
import type { NavBarLink } from "@/types/config";
import { url } from "@/utils/url-utils";

const currentPath = Astro.url.pathname;
const links = navBarConfig.links;

const normalizePath = (path: string) =>
	path === "/" ? path : `${path.replace(/\/+$/, "")}/`;

const isLinkActive = (link: NavBarLink) => {
	if (link.url === "#") {
		return link.children?.some((child) =>
			normalizePath(currentPath).startsWith(normalizePath(child.url)),
		);
	}

	if (link.url === "/") {
		return normalizePath(currentPath) === "/";
	}

	return normalizePath(currentPath).startsWith(normalizePath(link.url));
};
---

<nav id="navbar" class="network-navbar-shell" aria-label="主导航">
	<div class="network-navbar">
		<div class="network-nav-links">
			{
				links.map((link) =>
					link.children?.length ? (
						<details
							class:list={[
								"network-nav-dropdown",
								isLinkActive(link) && "is-active",
							]}
						>
							<summary class="network-nav-link">
								<Icon name={link.icon || "material-symbols:article"} />
								<span>{link.name}</span>
								<Icon
									name="material-symbols:keyboard-arrow-down-rounded"
									class="network-nav-chevron"
								/>
							</summary>
							<div class="network-nav-menu">
								{link.children.map((child) => (
									<a
										href={url(child.url)}
										class:list={[
											"network-nav-menu__item",
											isLinkActive(child) && "is-active",
										]}
									>
										<span class="network-nav-menu__icon">
											<Icon
												name={child.icon || "material-symbols:article-outline"}
											/>
										</span>
										<span>{child.name}</span>
										<Icon
											name="material-symbols:arrow-outward-rounded"
											class="network-nav-menu__arrow"
										/>
									</a>
								))}
							</div>
						</details>
					) : (
						<a
							href={link.external ? link.url : url(link.url)}
							target={link.external ? "_blank" : undefined}
							rel={link.external ? "noopener noreferrer" : undefined}
							aria-current={isLinkActive(link) ? "page" : undefined}
							class:list={[
								"network-nav-link",
								isLinkActive(link) && "is-active",
							]}
						>
							<Icon name={link.icon || "material-symbols:link"} />
							<span>{link.name}</span>
						</a>
					),
				)
			}
		</div>
	</div>
</nav>

<script>
	const closeNavigationDropdowns = (event: MouseEvent) => {
		document
			.querySelectorAll<HTMLDetailsElement>(".network-nav-dropdown[open]")
			.forEach((dropdown) => {
				if (event.target instanceof Node && !dropdown.contains(event.target)) {
					dropdown.removeAttribute("open");
				}
			});
	};

	document.addEventListener("click", closeNavigationDropdowns);
</script>

<style>
	.network-navbar-shell {
		display: block;
		width: 100%;
	}

	.network-navbar {
		display: flex;
		width: fit-content;
		max-width: calc(100vw - 1rem);
		height: 3.6rem;
		align-items: center;
		justify-content: center;
		margin: 0.7rem auto 0;
		padding: 0.32rem;
		border: 1px solid rgb(255 255 255 / 54%);
		border-radius: 999px;
		background: rgb(248 250 252 / 86%);
		box-shadow:
			0 16px 45px rgb(3 12 23 / 13%),
			inset 0 1px rgb(255 255 255 / 90%);
		backdrop-filter: blur(20px) saturate(150%);
	}

	#navbar > .network-navbar {
		border: 1px solid rgb(255 255 255 / 54%) !important;
		border-radius: 999px !important;
		background: rgb(248 250 252 / 86%) !important;
		box-shadow:
			0 16px 45px rgb(3 12 23 / 13%),
			inset 0 1px rgb(255 255 255 / 90%) !important;
		backdrop-filter: blur(20px) saturate(150%) !important;
	}

	.network-nav-links {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.25rem;
	}

	.network-nav-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0;
		min-height: 2.75rem;
		padding: 0 1.25rem;
		border-radius: 0.5rem;
		color: rgb(0 0 0 / 75%);
		font-family:
			"AaZongYiYuanNav", "AaZongYiYuan", system-ui, -apple-system,
			BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
		font-size: 1rem;
		font-weight: 700;
		letter-spacing: normal;
		text-decoration: none;
		transition:
			background-color 160ms ease,
			color 160ms ease,
			transform 160ms ease;
	}

	.network-nav-link :global(svg) {
		width: 1.1rem;
		height: 1.1rem;
		flex: 0 0 auto;
	}

	.network-nav-link :global(svg:first-child) {
		margin-right: 0.5rem;
	}

	.network-nav-link:hover,
	.network-nav-link.is-active,
	.network-nav-dropdown.is-active > .network-nav-link,
	.network-nav-dropdown[open] > .network-nav-link {
		background: oklch(0.95 0.025 210);
		color: rgb(0 0 0 / 75%);
	}

	.network-nav-link:active {
		transform: translateY(1px);
	}

	.network-nav-dropdown {
		position: relative;
	}

	.network-nav-dropdown > summary {
		cursor: pointer;
		list-style: none;
		outline: none;
	}

	.network-nav-dropdown > summary::-webkit-details-marker {
		display: none;
	}

	.network-nav-dropdown > summary:focus-visible,
	.network-nav-link:focus-visible {
		outline: 2px solid #22d3ee;
		outline-offset: 2px;
	}

	.network-nav-chevron {
		width: 1.25rem !important;
		height: 1.25rem !important;
		margin-right: 0 !important;
		margin-left: 0.25rem;
		transition: transform 160ms ease;
	}

	.network-nav-dropdown[open] .network-nav-chevron {
		transform: rotate(180deg);
	}

	.network-nav-menu {
		position: absolute;
		top: calc(100% + 0.68rem);
		left: 50%;
		z-index: 100;
		width: 13.5rem;
		padding: 0.62rem;
		border: 1px solid rgb(255 255 255 / 70%);
		border-radius: 1rem;
		background: rgb(250 252 253 / 94%);
		box-shadow: 0 24px 60px rgb(3 12 23 / 18%);
		backdrop-filter: blur(22px);
		transform: translateX(-50%);
	}

	.network-nav-menu__item {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 0.68rem;
		padding: 0.62rem 0.68rem;
		border-radius: 0.72rem;
		color: rgb(0 0 0 / 75%);
		font-family:
			"AaZongYiYuanNav", "AaZongYiYuan", system-ui, -apple-system,
			BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
		font-size: 0.9rem;
		font-weight: 500;
		text-decoration: none;
		transition:
			background-color 150ms ease,
			color 150ms ease;
	}

	.network-nav-menu__item:hover,
	.network-nav-menu__item.is-active {
		background: #e7f8fb;
		color: #008da6;
	}

	.network-nav-menu__icon {
		display: grid;
		width: 2rem;
		height: 2rem;
		place-items: center;
		border-radius: 0.58rem;
		background: #edf3f6;
	}

	.network-nav-menu__icon :global(svg),
	.network-nav-menu__arrow {
		width: 1.05rem;
		height: 1.05rem;
	}

	.network-nav-menu__arrow {
		opacity: 0.38;
	}

	@media (max-width: 520px) {
		.network-navbar {
			height: 3.3rem;
			margin-top: 0.45rem;
			padding: 0.25rem;
		}

		.network-nav-link {
			min-height: 2.65rem;
			gap: 0;
			padding: 0 0.7rem;
			font-size: 0.86rem;
		}

		.network-nav-link :global(svg) {
			width: 1rem;
			height: 1rem;
		}

		.network-nav-menu {
			width: 12.5rem;
		}
	}
</style>
