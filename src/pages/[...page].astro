---
import type { GetStaticPaths } from "astro";
import { Picture } from "astro:assets";
import HomeDataLayer from "@/components/layout/HomeDataLayer.astro";
import Footer from "@/components/layout/Footer.astro";
import Navbar from "@/components/layout/Navbar.astro";
import heroImage from "@/assets/images/professional/network-operations.webp";
import Layout from "@/layouts/Layout.astro";

export const getStaticPaths = (() => [
	{
		params: { page: undefined },
	},
]) satisfies GetStaticPaths;

const titleText = "next-hop.tech";
const titleLetters = Array.from(titleText);
const titleColors = [
	"#f8fbff",
	"#e7f9ff",
	"#c9f3fb",
	"#8fe5f4",
	"#4fd2eb",
	"#24b9dc",
];
---

<Layout
	title="Network Engineering Practice"
	description="ZeSheng Huang's network engineering blog, documenting network architecture, production incidents, data center practices, and automation."
>
	<header class="home-navbar-shell">
		<Navbar />
	</header>

	<main class="professional-home">
		<section class="home-hero" id="home-hero" aria-labelledby="home-hero-title">
			<div class="home-hero__media" aria-hidden="true">
				<Picture
					src={heroImage}
					alt=""
					formats={["avif", "webp"]}
					widths={[768, 1280, 1920]}
					sizes="100vw"
					loading="eager"
					fetchpriority="high"
				/>
			</div>
			<div class="home-hero__veil"></div>
			<div class="home-hero__grid"></div>
			<div class="home-hero__scanline"></div>

			<div class="home-hero__content">
				<h1
					id="home-hero-title"
					class="home-hero__name home-hero__name--css-hatch"
					aria-label={titleText}
				>
					{
						titleLetters.map((letter, index) => (
							<span
								class="home-hero__name-letter"
								style={`--letter-color:${titleColors[index % titleColors.length]};--letter-index:${index}`}
								aria-hidden="true"
							>
								{letter === " " ? "\u00a0" : letter}
							</span>
						))
					}
				</h1>
			</div>
		</section>

		<HomeDataLayer />
	</main>

	<div class="home-footer">
		<Footer />
	</div>
</Layout>
